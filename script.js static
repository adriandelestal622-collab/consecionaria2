// ============================================
// FUNCIÓN: MOSTRAR TOAST
// ============================================
function mostrarToast(mensaje, tipo = "info") {
    let toast = document.getElementById('toastNotificacion');
    let toastMensaje = document.getElementById('toastMensaje');
    
    if (!toast) {
        console.error("Toast no encontrado");
        alert(mensaje);
        return;
    }
    
    if (tipo === "error") {
        toast.style.backgroundColor = "#dc3545";
        toast.style.color = "white";
    } else if (tipo === "success") {
        toast.style.backgroundColor = "#28a745";
        toast.style.color = "white";
    } else {
        toast.style.backgroundColor = "#1e2a3e";
        toast.style.color = "#c9a03d";
    }
    
    toastMensaje.innerText = mensaje;
    toast.style.display = "flex";
    toast.style.opacity = "1";
    
    setTimeout(() => {
        toast.style.opacity = "0";
        setTimeout(() => {
            toast.style.display = "none";
        }, 300);
    }, 3000);
}

// ============================================
// FUNCIÓN: CONSULTAR AUTO (MEJORADA)
// ============================================
function consultarAuto(nombreAuto, precio) {
    // 1. Llenar el precio en el simulador de financiación
    document.getElementById('precioAuto').value = precio;
    
    // 2. Llenar el mensaje en el formulario de consulta rápida
    let mensajeTextarea = document.getElementById('mensajeCliente');
    if (mensajeTextarea) {
        mensajeTextarea.value = `Hola, quiero información del ${nombreAuto} que cuesta USD ${precio.toLocaleString()}. ¿Está disponible?`;
    }
    
    // 3. Llenar el campo "Auto de interés" en el formulario de turnos
    let turnoAutoInput = document.getElementById('turnoAuto');
    if (turnoAutoInput) {
        turnoAutoInput.value = nombreAuto;
        turnoAutoInput.style.borderColor = '#c9a03d';
        turnoAutoInput.style.boxShadow = '0 0 0 0.2rem rgba(201, 160, 61, 0.25)';
        setTimeout(() => {
            turnoAutoInput.style.borderColor = '';
            turnoAutoInput.style.boxShadow = '';
        }, 3000);
    }
    
    // 4. Scroll al formulario de consulta rápida
    document.getElementById('formularioContacto').scrollIntoView({ behavior: 'smooth' });
    
    // 5. Mostrar notificación
    mostrarToast(`💰 Auto seleccionado: ${nombreAuto}`, "info");
}

// ============================================
// FUNCIÓN: CALCULAR FINANCIACIÓN (CON CAMPOS OCULTOS)
// ============================================
function calcularFinanciacion() {
    console.log("Calculando financiación...");
    
    let precio = parseFloat(document.getElementById('precioAuto').value);
    let anticipo = parseFloat(document.getElementById('anticipo').value);
    let cuotas = parseInt(document.getElementById('cuotas').value);
    let dolarBlue = 1420;
    
    if (isNaN(precio) || precio <= 0) {
        mostrarToast("❌ Ingresá un precio válido", "error");
        return;
    }
    
    if (isNaN(anticipo) || anticipo < 0) {
        mostrarToast("❌ Ingresá un anticipo válido", "error");
        return;
    }
    
    let minimoAnticipo = precio * 0.20;
    console.log("Mínimo anticipo requerido:", minimoAnticipo);
    console.log("Anticipo ingresado:", anticipo);
    
    if (anticipo < minimoAnticipo) {
        mostrarToast(`⚠️ El anticipo mínimo es del 20%: USD ${minimoAnticipo.toLocaleString()}`, "error");
        return;
    }
    
    if (anticipo > precio) {
        mostrarToast("❌ El anticipo no puede ser mayor al precio", "error");
        return;
    }
    
    let financiarUSD = precio - anticipo;
    let cuotaMensualUSD = financiarUSD / cuotas;
    let financiarARS = financiarUSD * dolarBlue;
    let cuotaMensualARS = cuotaMensualUSD * dolarBlue;
    let anticipoARS = anticipo * dolarBlue;
    let precioARS = precio * dolarBlue;
    
    // Mostrar resultado en el simulador
    let resultadoDiv = document.getElementById('resultadoFinanciacion');
    resultadoDiv.classList.remove('d-none');
    resultadoDiv.innerHTML = `
        <div class="resultado-financiacion">
            <h5><i class="bi bi-check-circle-fill text-success me-2"></i>Tu plan de pagos</h5>
            <div class="row mt-3">
                <div class="col-6 text-center border-end">
                    <small class="text-muted">USD Dólares</small>
                    <p class="fw-bold mb-0" style="font-size:1.3rem;">USD ${cuotaMensualUSD.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</p>
                    <small>por mes</small>
                </div>
                <div class="col-6 text-center">
                    <small class="text-muted">ARS Pesos</small>
                    <p class="fw-bold mb-0" style="color:#c9a03d; font-size:1.3rem;">$${cuotaMensualARS.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0})}</p>
                    <small>por mes</small>
                </div>
            </div>
            <hr>
            <table class="table table-sm table-borderless mt-2">
                <tr>
                    <td><strong>💰 Precio:</strong></td>
                    <td class="text-end">USD ${precio.toLocaleString()} <span class="text-muted">($${precioARS.toLocaleString()} ARS)</span></td>
                </tr>
                <tr>
                    <td><strong>🏦 Anticipo:</strong></td>
                    <td class="text-end">USD ${anticipo.toLocaleString()} <span class="text-muted">($${anticipoARS.toLocaleString()} ARS)</span></td>
                </tr>
                <tr>
                    <td><strong>💵 Monto a financiar:</strong></td>
                    <td class="text-end">USD ${financiarUSD.toLocaleString()} <span class="text-muted">($${financiarARS.toLocaleString()} ARS)</span></td>
                </tr>
                <tr>
                    <td><strong>📆 Cuotas:</strong></td>
                    <td class="text-end">${cuotas} meses <span class="text-muted">(SIN INTERÉS)</span></td>
                </tr>
            </table>
            <div class="alert alert-info text-center mt-2 mb-0 py-2">
                <small>💡 Cotización: 1 USD = $${dolarBlue} ARS</small>
            </div>
        </div>
    `;
    
    // ============================================
    // 🔥 GUARDAR DATOS EN CAMPOS OCULTOS
    // ============================================
    
    const precioOculto = document.getElementById('turnoPrecioOculto');
    const anticipoOculto = document.getElementById('turnoAnticipoOculto');
    const cuotasOculto = document.getElementById('turnoCuotasOculto');
    const cuotaMensualOculto = document.getElementById('turnoCuotaMensualOculto');
    
    if (precioOculto) {
        precioOculto.value = precio;
        console.log("✅ Precio guardado:", precio);
    }
    if (anticipoOculto) {
        anticipoOculto.value = anticipo;
        console.log("✅ Anticipo guardado:", anticipo);
    }
    if (cuotasOculto) {
        cuotasOculto.value = cuotas;
        console.log("✅ Cuotas guardadas:", cuotas);
    }
    if (cuotaMensualOculto) {
        cuotaMensualOculto.value = cuotaMensualUSD.toFixed(2);
        console.log("✅ Cuota mensual guardada:", cuotaMensualUSD.toFixed(2));
    }
    
    // Mostrar el resumen en el formulario de turnos
    const resumenDiv = document.getElementById('resumenFinanciacionTurno');
    if (resumenDiv) {
        resumenDiv.style.display = 'block';
        document.getElementById('resumenPrecio').textContent = `USD ${precio.toLocaleString()}`;
        document.getElementById('resumenAnticipo').textContent = `USD ${anticipo.toLocaleString()}`;
        document.getElementById('resumenCuotas').textContent = `${cuotas} meses`;
        document.getElementById('resumenCuotaMensual').textContent = `USD ${cuotaMensualUSD.toFixed(2)}`;
        console.log("✅ Resumen mostrado");
    }
    
    mostrarToast(`✓ Cuota calculada: USD ${cuotaMensualUSD.toFixed(2)}`, "success");
}

// ============================================
// FUNCIÓN: OBTENER DATOS DE FINANCIACIÓN
// ============================================
function obtenerDatosFinanciacion() {
    const precioAuto = document.getElementById('turnoPrecioOculto').value || 'No especificado';
    const anticipo = document.getElementById('turnoAnticipoOculto').value || '0';
    const cuotas = document.getElementById('turnoCuotasOculto').value || '12';
    const cuotaMensual = document.getElementById('turnoCuotaMensualOculto').value || 'No calculado';
    
    console.log("📊 Leyendo campos ocultos:", {precioAuto, anticipo, cuotas, cuotaMensual});
    
    return {
        precio_auto: precioAuto,
        anticipo: anticipo,
        cuotas: cuotas,
        cuota_mensual: cuotaMensual
    };
}

// ============================================
// FUNCIONES: MODAL DE IMÁGENES
// ============================================
function verImagenGrande(src) {
    let modal = document.getElementById('imageModal');
    let modalImg = document.getElementById('modalImage');
    if (modal && modalImg) {
        modal.style.display = "flex";
        modalImg.src = src;
    }
}

function cerrarImagenGrande() {
    let modal = document.getElementById('imageModal');
    if (modal) {
        modal.style.display = "none";
    }
}

// ============================================
// EVENTOS AL CARGAR LA PÁGINA
// ============================================
document.addEventListener('DOMContentLoaded', function() {
    console.log("📄 DOM cargado");
    
    // Configurar fecha mínima para turnos
    const fechaInput = document.getElementById('turnoFecha');
    if (fechaInput) {
        const hoy = new Date().toISOString().split('T')[0];
        fechaInput.setAttribute('min', hoy);
        console.log("📅 Fecha mínima configurada:", hoy);
    }
    
    // ============================================
    // FORMULARIO DE CONSULTA RÁPIDA
    // ============================================
    let form = document.getElementById('formularioContacto');
    if (form) {
        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            let nombre = document.getElementById('nombreCliente').value.trim();
            let telefono = document.getElementById('telefonoCliente').value.trim();
            let email = document.getElementById('emailCliente').value.trim();
            let mensaje = document.getElementById('mensajeCliente').value.trim();
            
            if (!nombre || !telefono || !email) {
                mostrarToast("❌ Completá nombre, teléfono y email", "error");
                return;
            }
            
            let formData = new FormData();
            formData.append('nombre', nombre);
            formData.append('telefono', telefono);
            formData.append('email', email);
            formData.append('mensaje', mensaje);
            
            try {
                let response = await fetch('/guardar-consulta', { 
                    method: 'POST', 
                    body: formData 
                });
                let result = await response.json();
                
                if (response.ok) {
                    mostrarToast(`✅ ${result.mensaje}`, "success");
                    form.reset();
                } else {
                    mostrarToast(`❌ ${result.error}`, "error");
                }
            } catch (error) {
                console.error("Error:", error);
                mostrarToast("❌ Error de conexión con el servidor", "error");
            }
        });
    } else {
        console.error("No se encontró el formulario de consulta");
    }
    
    // ============================================
    // FORMULARIO DE RESERVA DE TURNOS
    // ============================================
    const formTurno = document.getElementById('formularioTurno');
    if (formTurno) {
        console.log("📋 Formulario de turnos encontrado");
        
        formTurno.addEventListener('submit', async function(e) {
            e.preventDefault();
            console.log("📅 Reservando turno...");
            
            // Obtener datos del formulario
            const nombre = document.getElementById('turnoNombre').value.trim();
            const telefono = document.getElementById('turnoTelefono').value.trim();
            const email = document.getElementById('turnoEmail').value.trim();
            const fecha = document.getElementById('turnoFecha').value;
            const hora = document.getElementById('turnoHora').value;
            const auto_interes = document.getElementById('turnoAuto').value.trim();
            const mensaje = document.getElementById('turnoMensaje').value.trim();
            
            // 🔥 Obtener datos de financiación de los campos ocultos
            const datosFinanciacion = obtenerDatosFinanciacion();
            console.log("📊 Datos de financiación a enviar:", datosFinanciacion);
            
            // Validaciones
            if (!nombre || !telefono || !fecha || !hora) {
                mostrarToast("❌ Completá nombre, teléfono, fecha y hora", "error");
                return;
            }
            
            const telefonoLimpio = telefono.replace(/\D/g, '');
            if (telefonoLimpio.length < 8) {
                mostrarToast("❌ Ingresá un teléfono válido (mínimo 8 dígitos)", "error");
                return;
            }
            
            const hoy = new Date().toISOString().split('T')[0];
            if (fecha < hoy) {
                mostrarToast("❌ La fecha no puede ser anterior a hoy", "error");
                return;
            }
            
            // Mostrar loading
            const btnSubmit = formTurno.querySelector('button[type="submit"]');
            const textoOriginal = btnSubmit.innerHTML;
            btnSubmit.innerHTML = `<i class="bi bi-hourglass-split me-2"></i> Guardando...`;
            btnSubmit.disabled = true;
            
            // Crear FormData con TODOS los datos
            const formData = new FormData();
            formData.append('nombre', nombre);
            formData.append('telefono', telefonoLimpio);
            formData.append('email', email);
            formData.append('fecha', fecha);
            formData.append('hora', hora);
            formData.append('auto_interes', auto_interes);
            formData.append('mensaje', mensaje);
            
            // 🔥 Agregar datos de financiación
            formData.append('precio_auto', datosFinanciacion.precio_auto);
            formData.append('anticipo', datosFinanciacion.anticipo);
            formData.append('cuotas', datosFinanciacion.cuotas);
            formData.append('cuota_mensual', datosFinanciacion.cuota_mensual);
            
            try {
                console.log("📤 Enviando datos al servidor...");
                
                const response = await fetch('/guardar-turno', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                console.log("📥 Respuesta del servidor:", result);
                
                if (response.ok) {
                    mostrarToast(`✅ ${result.mensaje}`, "success");
                    
                    const resultadoDiv = document.getElementById('resultadoTurno');
                    resultadoDiv.innerHTML = `
                        <div class="alert alert-success">
                            <h5><i class="bi bi-check-circle-fill text-success me-2"></i>¡Turno reservado!</h5>
                            <p>Hemos registrado tu turno. Ahora podés confirmarlo por WhatsApp:</p>
                            <a href="${result.whatsapp_url}" target="_blank" class="btn btn-success btn-lg w-100">
                                <i class="bi bi-whatsapp me-2"></i>
                                Enviar mensaje a WhatsApp
                            </a>
                            <small class="d-block mt-2 text-muted">ID de turno: #${result.turno_id}</small>
                        </div>
                    `;
                    
                    formTurno.reset();
                    
                    // Ocultar el resumen
                    const resumenDiv = document.getElementById('resumenFinanciacionTurno');
                    if (resumenDiv) {
                        resumenDiv.style.display = 'none';
                    }
                    
                } else {
                    mostrarToast(`❌ ${result.error}`, "error");
                }
                
            } catch (error) {
                console.error("❌ Error:", error);
                mostrarToast("❌ Error de conexión con el servidor", "error");
            }
            
            btnSubmit.innerHTML = textoOriginal;
            btnSubmit.disabled = false;
        });
    } else {
        console.log("ℹ️ Formulario de turnos no encontrado");
    }
    
    // Cerrar modal con ESC
    document.addEventListener('keydown', function(e) {
        if (e.key === "Escape") cerrarImagenGrande();
    });
});

console.log("✅ Todos los eventos configurados correctamente");
